          "308": {
            "description": "A valid week with zero-padded path segments; permanent redirect to the canonical API path, e.g. `/api/weeks/2026/044` to `/api/weeks/2026/44`.",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Location": {
                "description": "Canonical API path.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No plan for this valid week, an invalid year or week, or any other path under `/api`.",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "week_not_found": {
                    "summary": "Valid week without a plan",
                    "value": {
                      "error": {
                        "code": "week_not_found",
                        "message": "No meal plan for this week yet."
                      }
                    }
                  },
                  "invalid_week": {
                    "summary": "Invalid year or week",
                    "value": {
                      "error": {
                        "code": "invalid_week",
                        "message": "Invalid week."
                      }
                    }
                  },
                  "not_found": {
                    "summary": "Any other path under /api",
                    "value": {
                      "error": {
                        "code": "not_found",
                        "message": "Not found."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Only GET is supported. No JSON body is guaranteed.",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable. The body never contains database details.",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
