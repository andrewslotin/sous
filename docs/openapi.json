{
  "openapi": "3.1.0",
  "info": {
    "title": "Sous read API",
    "version": "1",
    "description": "Read-only JSON API for weekly meal plans. The document format version is the `schemaVersion` field. Every response carries `Cache-Control: no-store`. No cross-origin access is enabled."
  },
  "paths": {
    "/api/weeks/{year}/{week}": {
      "get": {
        "operationId": "getWeek",
        "summary": "Get the complete meal plan of one ISO week.",
        "description": "Uses the same query and document as the HTML page `/{year}/{week}`, read from one database snapshot. Every other path under `/api` returns the `not_found` error with status 404.",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "description": "ISO week-year: exactly four decimal digits, 0001 to 9999 (years below 1000 are zero-padded, e.g. `0001`), and all seven days of the requested week must be representable. Anything else is `invalid_week`.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}$",
              "examples": [
                "2026"
              ]
            }
          },
          {
            "name": "week",
            "in": "path",
            "required": true,
            "description": "ISO week number, 1 to the number of weeks in that ISO year (52 or 53). Zero-padded but otherwise valid values (for example `044`) redirect permanently to the canonical path. Anything else is `invalid_week`.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "examples": [
                "44"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The week document.",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeekDocument"
                },
                "example": {
                  "schemaVersion": 1,
                  "week": {
