  "components": {
    "schemas": {
      "WeekDocument": {
        "type": "object",
        "description": "The complete meal plan of one ISO week. Identical to the document embedded in the HTML page.",
        "properties": {
          "schemaVersion": {
            "const": 1,
            "type": "integer",
            "description": "API format version; independent of SQL migration versions."
          },
          "week": {
            "$ref": "#/components/schemas/Week"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Day"
            },
            "description": "Always seven entries, Monday (weekday 1) to Sunday (weekday 7), including days without a stored record."
          },
          "shoppingLists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShoppingList"
            },
            "description": "Every shopping list of the week in stored order, including lists not assigned to any day. Days refer to them by ID."
          },
          "prepSessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrepSession"
            },
            "description": "Prep sessions in stored order; empty when the week has none."
          },
          "strategyCards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StrategyCard"
            },
            "description": "Strategy cards in stored order; empty when the week has none."
          }
        },
        "required": [
          "schemaVersion",
          "week",
          "days",
          "shoppingLists",
          "prepSessions",
          "strategyCards"
        ],
        "additionalProperties": false
      },
      "Week": {
        "type": "object",
        "description": "Identity and dates of the ISO week.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable week ID."
          },
          "isoYear": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999,
            "description": "ISO week-year."
          },
          "isoWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 53,
            "description": "ISO week number."
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Monday of the week."
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Sunday of the week."
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional one-line description of the week."
          },
          "prepIntro": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional introduction shown above the prep sessions."
          }
        },
        "required": [
          "id",
          "isoYear",
          "isoWeek",
          "startDate",
          "endDate",
          "subtitle",
          "prepIntro"
        ],
        "additionalProperties": false
      },
      "Day": {
        "type": "object",
        "description": "One day of the week.",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Stable day ID; null when the day has no stored record (then meals and shoppingListIds are empty and reminder is null)."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Calendar date of this day."
          },
          "weekday": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "ISO weekday, 1 = Monday."
          },
          "meals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meal"
            },
            "description": "Meals in stored order."
          },
          "shoppingListIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "description": "ID of an entry of the top-level shoppingLists."
            },
            "description": "Lists shown on this day, in stored order."
          },
          "reminder": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Reminder"
              },
              {
                "type": "null"
              }
            ],
            "description": "Day reminder; null unless the day has a reminder title."
          }
        },
        "required": [
          "id",
          "date",
