  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Finds meals whose name or description contains query as a literal, case-insensitive substring (wildcard characters match themselves; no fuzzy matching). fromDate and toDate bound the meal's date inclusively. At least a nonempty query or one date bound is required. Results span past and future weeks, newest date first, then meal position, and are paged with nextCursor/cursor. An empty result is a normal response; widen the date range yourself if appropriate. Use get_meal with a result's id for the full recipe.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "`nextCursor` from the previous page of the same call.",
          "type": [
            "string",
            "null"
          ]
        },
        "fromDate": {
          "description": "Inclusive start of the date filter, `YYYY-MM-DD`.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Page size, 1 to 100. Defaults to 20.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "description": "Literal, case-insensitive text to find in meal names and descriptions. Required unless a date\nbound is given.",
          "type": [
            "string",
            "null"
          ]
        },
        "toDate": {
          "description": "Inclusive end of the date filter, `YYYY-MM-DD`.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
