    "description": "Returns the service's current date, its IANA timezone, and the current ISO week with its start and end dates and page path. Call this first to resolve relative dates such as \"today\" or \"three weeks ago\"; the server accepts only explicit YYYY-MM-DD dates. Takes no arguments.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "type": "object"
    },
    "name": "get_context",
    "outputSchema": {
      "$defs": {
        "WeekSummary": {
          "description": "One archive entry / available-week link.",
          "properties": {
            "endDate": {
              "type": "string"
            },
            "isoWeek": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "isoYear": {
              "format": "int32",
              "type": "integer"
            },
            "path": {
              "description": "Canonical page path, e.g. `/2026/44`.",
              "type": "string"
            },
            "startDate": {
              "type": "string"
            }
          },
          "required": [
            "isoYear",
            "isoWeek",
            "startDate",
            "endDate",
            "path"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "currentWeek": {
          "$ref": "#/$defs/WeekSummary"
        },
        "timezone": {
          "description": "IANA name of `APP_TIMEZONE`, e.g. `Europe/Berlin`.",
          "type": "string"
        },
        "today": {
          "description": "`YYYY-MM-DD` in the service timezone.",
          "type": "string"
        }
      },
      "required": [
        "today",
        "timezone",
        "currentWeek"
      ],
      "type": "object"
    },
    "title": "Get today's date and the current week"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Lists stored meal-plan weeks, newest first, whose Monday-to-Sunday range overlaps the inclusive fromDate/toDate filter (either bound may be omitted). Results are paged: pass nextCursor back as cursor, with the same filters, until it is null. A reversed range or an invalid date is invalid_input.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "`nextCursor` from the previous page of the same call.",
          "type": [
            "string",
            "null"
          ]
        },
        "fromDate": {
          "description": "Inclusive start of the date filter, `YYYY-MM-DD`.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Page size, 1 to 100. Defaults to 20.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "toDate": {
          "description": "Inclusive end of the date filter, `YYYY-MM-DD`.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
