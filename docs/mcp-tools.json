            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "isoWeek": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "isoYear": {
              "format": "int32",
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "weekPath": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "description",
            "type",
            "date",
            "isoYear",
            "isoWeek",
            "weekPath"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "meals": {
          "items": {
            "$ref": "#/$defs/MealHit"
          },
          "type": "array"
        },
        "nextCursor": {
          "description": "Null when there are no further results.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "meals"
      ],
      "type": "object"
    },
    "title": "Search saved meals"
  },
